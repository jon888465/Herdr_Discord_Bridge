{
  // Runtime: "herdr" (default) or "core"; HERDR_BRIDGE_RUNTIME overrides this.
  // run.sh Herdr launcher explicitly sets runtime=herdr even if this field is core.
  // Core run.sh requires file discord.botToken when caller uses an environment token;
  // tokens are never forwarded through argv and inherited token variables are cleared.
  // Core supports terminal commands; workspace/team/card operations are unsupported.
  "runtime": "herdr",
  // Canonical Core terminal addresses allowed to receive input; rechecked live per send/key.
  // Empty: listing/visible reads allowed, all input denied. Bind threads with target/use.
  // Core requires allowedWorkspaceIds and machines to be empty.
  "coreAllowedTerminals": [],
  // Core standalone default: ~/.config/herdr-discord-bridge/config.json; when that file
  // is missing, run.sh --core falls back to the Herdr plugin config directory below.
  // HERDR_PLUGIN_CONFIG_DIR overrides the bridge config directory for either backend.
  // For Herdr plugins, copy this file to the directory printed by:
  //   herdr plugin config-dir herdr-discord-bridge
  // The real config is gitignored. Environment variables override file values.
  "discord": {
    "enabled": true,
    "botToken": "",
    "allowedGuildIds": [],
    "allowedChannelIds": [],
    "allowedUserIds": [],
    "messageContent": true,
    "requireMention": true,
    "soloThreadNoMention": false,
    "commandPrefix": "/herdr",
  },
  // Hook channel per CLI (ISSUE-045): "auto" = hook first, screen parser as fallback;
  // "parser" = ignore hooks for that CLI. Only claude, codex, agy and pi support hooks.
  "hookTransport": { "claude": "auto", "codex": "auto", "agy": "auto", "pi": "auto" },
  // Remote Herdr machines (ISSUE-041). IDs without a "<id>:" prefix are always local.
  // `socket` is the remote Herdr API socket; the bridge forwards it over `ssh -L`.
  "machines": [
    // Optional `hookSocket`: remote path of a unix socket the bridge reverse-forwards (`ssh -R`)
    // to its local hook socket, so remote Stop hooks reach the bridge (ISSUE-045).
    { "id": "agy-pod", "ssh": "agy-pod", "socket": "/root/.config/herdr/herdr.sock", "hookSocket": "/root/.config/herdr-discord-bridge/hooks.sock" },
  ],
  // Profiles are definitions, not running panes. Enable them per workspace with team select.
  // Model names must be supported by your installed CLI/account; no model is forced here.
  "agentProfiles": [
    {
      "id": "helper",
      "kind": "codex",
      "args": [],
      "capabilities": ["implementation", "analysis"],
    },
    {
      "id": "reviewer",
      "kind": "codex",
      "args": [],
      "capabilities": ["review"],
    },
  ],
  // 本機 agy 的工作目錄正好等於這裡的路徑時，bridge 會把它補進 agy 的信任清單（不自動移除；不含上層、子目錄、家目錄）。
  // 這等於替整個資料夾預先信任，請只列你自己確認過的目錄。預設空。
  "agyTrustedDirectories": [],
  "notifyOn": ["blocked"],
  "allowedWorkspaceIds": [],
  "pollIntervalMs": 2000,
  "requestTimeoutMs": 5000,
  "reconnectBaseMs": 250,
  "approvalTimeoutMs": 900000,
  "teamTurnTimeoutMs": 1800000,
  "outputLines": 500,
  "handoffLines": 40,
  "handoffMaxChars": 6000,
  "streamIntervalMs": 1200,
  "maxTrackedApprovals": 256,
  "stateFile": "routing.json",
}
